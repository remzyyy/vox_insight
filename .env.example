# ── LLM / Embeddings ─────────────────────────────────────────────
# Optional. If unset, the system falls back to local heuristics/embeddings.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Q1 Voice Agent (Vapi) ────────────────────────────────────────
# Set a shared secret; Vapi sends it so the webhook can verify requests.
VAPI_WEBHOOK_SECRET=change-me
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=

# ── Q4 Real-time ─────────────────────────────────────────────────
# Optional ASR provider for live audio (Deepgram used as example).
DEEPGRAM_API_KEY=

# ── App ──────────────────────────────────────────────────────────
KB_STORE_PATH=data/kb_store.sqlite
LOG_LEVEL=INFO
